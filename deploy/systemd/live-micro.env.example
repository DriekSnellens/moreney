# Live micro production API (:8020)
# Copy to env/live-micro.env on the server (env/ is gitignored).
# Secrets + exchange keys: env/bitvavo-observe.env (loaded first by systemd unit)
# Install: sudo cp deploy/systemd/moreney-live@.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now moreney-live@micro
# Dashboard: http://<host>:8020/live/micro/dashboard

API_PORT=8020
API_HOST=0.0.0.0

EXECUTION_MODE=paper
PAPER_TRADING_ENABLED=false
PAPER_AUTO_START=false
PAPER_STARTING_EUR=2000
PAPER_PERSIST_PATH=./data/live_micro_fullbot_state.json
LIVE_MICRO_BRIDGE_PERSIST_PATH=./data/live_micro_bridge_state.json

MARKET_DATA_MODE=local
MARKET_DATA_REDIS_POLL_MS=100
RESEARCH_MARKETDATA_RECORDING_ENABLED=false
MARKETDATA_RETENTION_DAYS=3

PAPER_CYCLE_INTERVAL_MS=1200
PAPER_MAKER_ENABLED=true
PAPER_MAKER_VENUES=okx,bitvavo
PAPER_MAKER_MIN_NOTIONAL_EUR=60
PAPER_MAKER_MIN_PROFIT_EUR=0.05
PAPER_MAKER_MIN_NET_RETURN=0.0005
PAPER_MAKER_MIN_SPREAD_BPS=5
PAPER_MAKER_ADVERSE_BPS=2
PAPER_MAKER_SPREAD_FEE_BUFFER_BPS=1
PAPER_MAKER_ALLOW_BUY_ONLY=true
PAPER_MAKER_SELL_PROFIT_BUFFER_BPS=10
PAPER_VENUE_INVENTORY=true
PAPER_INVENTORY_BUY_DIP_BPS=0
PAPER_MAX_ALT_INVENTORY_PCT=35
PAPER_MIN_ALT_INVENTORY_PCT=15
PAPER_REGIME_BLOCK_BUYS=true
PAPER_DUST_POLICY=top_up_or_exit
PAPER_DUST_EXIT_SLACK_BPS=0
PAPER_LADDER_BUY_ENABLED=true
PAPER_LADDER_BUY_PCTS=0,0.0015,0.004
PAPER_TIME_STOP_ENABLED=true
PAPER_TIME_STOP_SEC=3600
PAPER_TIME_STOP_MIN_PROFIT_BPS=25
PAPER_TRAIL_TAKE_PROFIT_ENABLED=true
PAPER_TRAIL_SESSION_BUYS_ONLY=false
PAPER_TRAIL_SOFT_ARM_PCT=0.02
PAPER_TRAIL_SOFT_DRAWDOWN_PCT=0.005
PAPER_TRAIL_SOFT_PARTIAL_PCT=0.50
PAPER_TRAIL_RECOVERY_BE_PARTIAL_PCT=0.35
PAPER_TRAIL_HARD_ARM_PCT=0.06
PAPER_TRAIL_HARD_DRAWDOWN_PCT=0.03
PAPER_TRAIL_HARD_PARTIAL_PCT=0.25
PAPER_TRAIL_PARTIAL_ENABLED=true
PAPER_TRAIL_ATR_ENABLED=false
PAPER_BUY_MOMENTUM_ENABLED=true
PAPER_BUY_MOMENTUM_MIN_RETURN=0.0015
PAPER_BUY_MOMENTUM_SAMPLES=12
PAPER_MARKOUT_ENABLED=false
PAPER_FEE_TIER=retail

ARBITRAGE_MAX_EMITS_PER_CYCLE=4
OPPORTUNITY_MAX_EXECUTIONS_PER_CYCLE=6
MAX_SIMULTANEOUS_POSITIONS=3
RISK_MAX_OPEN_POSITIONS=3
PROFITABILITY_MIN_NET_PROFIT_USD=0.05
PROFITABILITY_MIN_NET_RETURN=0.0005
RISK_MIN_NET_PROFIT_USD=0.05
LIVE_MICRO_CROSS_VENUE_ENABLED=false
LIVE_MICRO_UNDERWATER_BLOCK_NEW_BASES_ONLY=true
LIVE_MICRO_OKX_BUY_IMPROVE_BPS=1.0
LIVE_MICRO_CUT_LOSS_NEW_BASES_ONLY=false
LIVE_MICRO_MOMENTUM_EXIT_MIN_RETURN=0.003
LIVE_MICRO_MOMENTUM_EXIT_ABOVE_BE_PCT=0.005

DASHBOARD_BASIC_AUTH_ENABLED=false
DISK_GUARD_WARN_PCT=85
DISK_GUARD_BLOCK_PCT=92
