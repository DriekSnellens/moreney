# Realistic paper twin — retail fees, honest fills. Not Ultra.
# Copy into env/paper-<size>live.env (that directory is gitignored).
#
# Unchanged vs Ultra on purpose:
#   PAPER_FEE_TIER=retail
#   PAPER_MAKER_QUEUE_FILL_PCT=0
#   PAPER_MAKER_TRADE_THROUGH_FILL_PCT=0.20
#   PAPER_MAKER_FAIR_VALUE=true
#   PAPER_MAKER_ADVERSE_BPS=4
#
# Retail-preserving edge hunt:
#   book level 1 (wider spread, harder trade-through)
#   max edge 80 bps (alt/Bitvavo width is not a stale BTC book)
#   drop Kraken (16–26 bps maker almost never clears)
#   seed wider-spread alts instead of tight XRP

PAPER_MAKER_BOOK_LEVEL=1
PAPER_MAKER_MAX_EDGE_BPS=80
PAPER_MAKER_VENUES=okx,binance,bitvavo
PAPER_MAKER_MAX_OPEN_QUOTES=10
PAPER_CYCLE_INTERVAL_MS=400
PAPER_SEED_MAX_ASSETS=5
PAPER_SEED_SYMBOLS=ATOMEUR,DOTEUR,ADAEUR,BNBEUR,NEAREUR
PAPER_TRIANGLE_BASES=ATOM,DOT,ADA,BNB,NEAR
PAPER_FEE_TIER=retail
PAPER_MAKER_QUEUE_FILL_PCT=0
PAPER_MAKER_TRADE_THROUGH_FILL_PCT=0.20
PAPER_MAKER_FAIR_VALUE=true
PAPER_MAKER_ADVERSE_BPS=4
