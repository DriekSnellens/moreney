# Realistic paper — retail fees, honest fills.
# Copy into env/paper-<size>live.env (that directory is gitignored).
#
# Grow equity via sized maker quotes, not trade count and not idle alt-beta.
# ~30% inventory is enough to sell; the rest stays quote cash so a €25k book
# can quote thousands of euros when NET clears retail fees.
#
# Unchanged honesty knobs:
#   PAPER_FEE_TIER=retail
#   PAPER_MAKER_QUEUE_FILL_PCT=0
#   PAPER_MAKER_FAIR_VALUE=true
#   PAPER_MAKER_ADVERSE_BPS=4

PAPER_MAKER_BOOK_LEVEL=1
PAPER_MAKER_MAX_EDGE_BPS=80
PAPER_MAKER_VENUES=okx,binance,bitvavo
PAPER_MAKER_MAX_OPEN_QUOTES=6
# Hard NET floors: no stofjes, no thin fills after retail fees + slippage buffer.
PAPER_MAKER_MIN_PROFIT_EUR=0.15
PAPER_MAKER_MIN_NET_RETURN=0.0025
PAPER_MAKER_MIN_NOTIONAL_EUR=10
PAPER_MAKER_MIN_PROFIT_EQUITY_BPS=0.2
PAPER_MAKER_KEEP_VS_BEST_FRAC=0.35
PAPER_MAKER_REPLACE_IMPROVE_FRAC=0.25
# Inventory skew (Avellaneda-Stoikov): max 30% alt, selective buys below 10%.
PAPER_MAX_ALT_INVENTORY_PCT=30
PAPER_MIN_ALT_INVENTORY_PCT=10
PAPER_INVENTORY_ASK_IMPROVE_BPS=4
PAPER_INVENTORY_BUY_DIP_BPS=8
# Dump guard: pull bids if mid drops ≥1.5% in 5 minutes.
PAPER_VOL_MOVE_PCT=1.5
PAPER_VOL_WINDOW_SEC=300
PAPER_VOL_COOLDOWN_SEC=120
# Capital velocity: recycle flat/losing alt after 120 minutes.
PAPER_MAX_HOLDING_SEC=7200
PAPER_CYCLE_INTERVAL_MS=200
PAPER_SEED_INVENTORY_PCT=30
PAPER_SEED_USDT_PCT=15
PAPER_SEED_MAX_ASSETS=5
PAPER_SEED_SYMBOLS=ADAEUR,ATOMEUR,NEAREUR,DOTEUR,XRPEUR
PAPER_TRIANGLE_BASES=ADA,ATOM,NEAR,DOT,XRP
PAPER_FEE_TIER=retail
PAPER_MAKER_QUEUE_FILL_PCT=0
PAPER_MAKER_TRADE_THROUGH_FILL_PCT=1.0
PAPER_MAKER_FAIR_VALUE=true
PAPER_MAKER_ADVERSE_BPS=4
ARBITRAGE_MAX_QUANTITY=10000
ARBITRAGE_POSITION_PCT=25
ARBITRAGE_OPPORTUNITY_COOLDOWN_MS=400
ARBITRAGE_MAX_EMITS_PER_CYCLE=4
ARBITRAGE_MIN_PROFIT_PCT=0.00015
OPPORTUNITY_MAX_EXECUTIONS_PER_CYCLE=4
PAPER_MAKER_MAX_AGE_MS=60000
PAPER_MAKER_SIBLING_GRACE_MS=60000
PAPER_MAKER_ONE_LEG_EXIT=true
PAPER_HYBRID_HEDGE=true
MAX_POSITION_PERCENT=30
MAX_TOTAL_EXPOSURE_PERCENT=90
MAX_DAILY_LOSS_PERCENT=8
MAX_SIMULTANEOUS_POSITIONS=16
GLOBAL_MAX_STRATEGY_EXPOSURE_PCT=80
GLOBAL_MAX_CORRELATION_EXPOSURE_PCT=80
GLOBAL_MAX_VENUE_EXPOSURE_PCT=50
PAPER_HMM_ENABLED=true
PAPER_HMM_MIN_SAMPLES=80
PAPER_HMM_REFIT_EVERY_CYCLES=30
PAPER_HMM_VOL_WINDOW=14
PAPER_HMM_HISTORY_LEN=750
PAPER_HMM_UPTREND_ASK_IMPROVE_BPS=4
PAPER_HMM_REFIT_EVERY_SEC=18000
PAPER_HMM_ATR_WINDOW=14
PAPER_HMM_CANDLE_SEC=300
PAPER_HMM_TOXIC_CONFIRM_STEPS=2
PAPER_HMM_TOXIC_PROBA_THRESHOLD=0.70
PAPER_HMM_NORMAL_INVENTORY_PCT=0.30
PAPER_HMM_TOXIC_INVENTORY_PCT=0.10
