# HTTPS front door for https://moreney.ai
# Origin stays on 127.0.0.1:8020 — do not expose 8020 on the public NIC.
#
# Cloudflare: orange-cloud A/AAAA to this VPS, SSL/TLS mode Full (strict).
# Origin presents a Let's Encrypt cert (copied to /etc/caddy/certs).
# ACME HTTP-01 is served from /var/www/acme so Cloudflare's HTTP→HTTPS
# redirect still completes the challenge on this origin.

:80 {
	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8020
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
		}
	}
}
