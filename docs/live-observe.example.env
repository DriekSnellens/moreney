# Live observe — read-only API keys (NO withdraw permission)
# Copy values into your process env / systemd EnvironmentFile.
# Never commit real secrets.

LIVE_OBSERVE_ENABLED=true
FUNDING_MAIN_VENUE=bitvavo
FUNDING_VENUES=bitvavo,kraken,binance,okx

# Keep all order unlocks OFF until Phase 0+1 are green and dry-run passes.
LIVE_TRADING_ENABLED=false
LIVE_MICRO_ENABLED=false
LIVE_ORDERS_UNLOCKED=false
LIVE_ALLOW_WITHOUT_RESEARCH_UNLOCK=false
AUTOMATIC_WITHDRAWALS_ENABLED=false

# Per-venue keys (create on each exchange with withdraw DISABLED):
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Verify:
#   curl -s localhost:8000/live/credentials
#   curl -s 'localhost:8000/live/credentials?probe=true'
#   curl -s localhost:8000/live/observe
#   curl -s localhost:8000/live/micro/engine
#   curl -s localhost:8000/live/micro/unlock-checklist
#   curl -s -X POST localhost:8000/live/micro/dry-run \
#     -H 'Content-Type: application/json' \
#     -d '{"venue":"bitvavo","symbol":"BTCEUR","notional_eur":25}'
# After env unlocks + restart:
#   curl -s -X POST localhost:8000/live/micro/arm
#   curl -s -X POST localhost:8000/live/micro/orders \
#     -H 'Content-Type: application/json' \
#     -d '{"venue":"bitvavo","symbol":"BTCEUR","notional_eur":25,"confirm":true}'
#
# Full-bot micro (small capital, full pipeline — not a 2-symbol toy loop):
#   set -a && source env/bitvavo-observe.env && set +a
#   # unlock LIVE_* only for the timed window, then:
#   python -m bot.live.micro_session --minutes 15 --budget-eur 25
