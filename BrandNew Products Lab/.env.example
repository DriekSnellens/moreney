# Copy to .env.local. Never commit real keys.
# DATA_MODE=demo works with no credentials. DATA_MODE=live does not load demo records.

DATA_MODE=demo
DATABASE_URL=
OPERATOR_PASSWORD=
OPERATOR_SESSION_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

CREATIFY_API_ID=
CREATIFY_API_KEY=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Set only when you intend to pay for a render. The UI does not flip this.
VIDEO_ALLOW_SPEND=

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Set only when you intend to create a paused campaign at Meta.
META_ALLOW_WRITE=
TIKTOK_ACCESS_TOKEN=

CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

POSTHOG_KEY=
POSTHOG_HOST=

TEMPORAL_ADDRESS=
WORKFLOW_RUNNER=in-process

# Optional legitimate feeds. When empty in live mode the UI says "Provider not configured".
TRENDS_API_URL=
SUPPLIER_FEED_URL=
