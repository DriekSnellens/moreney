# Application
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Execution mode: paper | live
EXECUTION_MODE=paper

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://moreney:moreney@localhost:5432/moreney

# Redis
REDIS_URL=redis://localhost:6379/0

# Risk defaults (fail-closed, no leverage)
RISK_MAX_POSITION_USD=1000.0
RISK_MAX_DAILY_LOSS_USD=200.0
RISK_MAX_OPEN_POSITIONS=5
RISK_MIN_NET_PROFIT_USD=1.0
MAX_POSITION_PERCENT=10
MAX_TOTAL_EXPOSURE_PERCENT=85
MAX_DAILY_LOSS_PERCENT=3
MAX_DRAWDOWN_PERCENT=5
MAX_SIMULTANEOUS_POSITIONS=5
MAX_TRADES_PER_MINUTE=30
MAX_SLIPPAGE_PERCENT=0.10
MAX_MARKET_DATA_AGE_MS=1000
MAX_EXECUTION_LATENCY_MS=2000
MAX_ABNORMAL_PRICE_MOVE_PERCENT=5
MIN_LIQUIDITY_BASE=0.01
RISK_CONSECUTIVE_FAILURE_LIMIT=5
RISK_WARNING_DAILY_LOSS_PERCENT=2
RISK_WARNING_DRAWDOWN_PERCENT=3
RISK_REQUIRE_MANUAL_RECOVERY=true

# Profitability (NET profit — never gross spread alone)
PROFITABILITY_FEE_RATE=0.001
PROFITABILITY_MAKER_FEE_RATE=0.0008
PROFITABILITY_TAKER_FEE_RATE=0.001
PROFITABILITY_SLIPPAGE_BPS=2.0
PROFITABILITY_MARKET_IMPACT_FACTOR=1.0
PROFITABILITY_THIN_BOOK_PENALTY_BPS=0.0
PROFITABILITY_FUNDING_RATE=0.0001
PROFITABILITY_APPLY_FUNDING=false
PROFITABILITY_EXECUTION_BUFFER_BPS=5.0
PROFITABILITY_MIN_NET_PROFIT_USD=0.10
PROFITABILITY_MIN_NET_RETURN=0.0003

# Cross-exchange arbitrage
ARBITRAGE_MIN_PROFIT_EUR=0.01
ARBITRAGE_MIN_PROFIT_PCT=0.00005
ARBITRAGE_MIN_LIQUIDITY_BASE=0.0001
ARBITRAGE_MAX_QUANTITY=0.005
ARBITRAGE_POSITION_PCT=8
ARBITRAGE_OPPORTUNITY_COOLDOWN_MS=3000
ARBITRAGE_MAX_EMITS_PER_CYCLE=2
ARBITRAGE_MAX_LATENCY_MS=1000.0
ARBITRAGE_MAX_BOOK_AGE_MS=1000.0

# Paper trading (isolated from live — NEVER places real orders)
PAPER_TRADING_ENABLED=true
PAPER_AUTO_START=false
PAPER_STARTING_EUR=200
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_MODE=order_book
PAPER_FIXED_SLIPPAGE_PCT=0.05
PAPER_PARTIAL_FILLS_ON_THIN_BOOK=true
PAPER_REJECT_ON_INSUFFICIENT_LIQUIDITY=false
PAPER_SIMULATED_LATENCY_MS=0
PAPER_QUOTE_ASSET=EUR
PAPER_CYCLE_INTERVAL_MS=1000
PAPER_PERSIST_PATH=./data/paper_state.json
PAPER_VENUE_INVENTORY=true
PAPER_SEED_INVENTORY_PCT=50
PAPER_SEED_MAX_ASSETS=3
PAPER_SEED_SYMBOLS=ATOMEUR,DOTEUR,XRPEUR

# Maker quoting — fee-first EUR alts, concentrated inventory (okx/binance/bitvavo).
PAPER_MAKER_ENABLED=true
PAPER_MAKER_REST_MS=0
PAPER_MAKER_QUEUE_FILL_PCT=0
PAPER_MAKER_TRADE_THROUGH_FILL_PCT=0.20
PAPER_MAKER_MAX_AGE_MS=4000
PAPER_MAKER_MIN_SPREAD_BPS=3
PAPER_MAKER_MAX_EDGE_BPS=30
PAPER_MAKER_MIN_PROFIT_EUR=0.001
PAPER_MAKER_SAME_VENUE=true
PAPER_MAKER_MAX_OPEN_QUOTES=6
PAPER_MAKER_VENUES=okx,binance,bitvavo,kraken
PAPER_MAKER_MAX_FEE_BPS=35
PAPER_MAKER_SIBLING_GRACE_MS=8000
PAPER_MAKER_ONE_LEG_EXIT=true
PAPER_MAKER_ONE_LEG_ADVERSE_BPS=6
PAPER_MAKER_ADVERSE_BPS=4
PAPER_MAKER_FAIR_VALUE=true
PAPER_MAKER_FX_SYMBOL=EURUSDT
PAPER_MAKER_BOOK_LEVEL=0
PAPER_HYBRID_HEDGE=true
PAPER_HYBRID_ADVERSE_BPS=8
PAPER_TRIANGLE_ENABLED=true
PAPER_TRIANGLE_BASES=BTC,ETH,ATOM,DOT,XRP
PAPER_SEED_USDT_PCT=20
PAPER_REBALANCE_ENABLED=true
PAPER_REBALANCE_EVERY_CYCLES=120
PAPER_REBALANCE_FEE_BPS=5
PAPER_FEE_TIER=retail
PAPER_MARKOUT_ENABLED=true
PAPER_MARKOUT_FLOOR_BPS=2
PAPER_MARKOUT_CEILING_BPS=15

# Global opportunity engine (multi-market architecture)
GLOBAL_OPPORTUNITY_ENGINE_ENABLED=true
GLOBAL_TIERED_SCAN_ENABLED=true
GLOBAL_USE_GLOBAL_COMPOSITE=true
GLOBAL_FUNDING_STRATEGY_ENABLED=true
GLOBAL_MIN_FUNDING_BPS=3
GLOBAL_FUNDING_POLL_INTERVAL_SEC=60
GLOBAL_FUNDING_EXCHANGES=binance
GLOBAL_TRANSFER_FEE_BPS=10
GLOBAL_TRANSFER_LATENCY_BPS=5
GLOBAL_FX_ENABLED=false
# Equity paper quotes: Nasdaq public JSON (US live bid/ask, no key) + Yahoo chart (EU).
# Unofficial public endpoints — not a licensed SIP feed. Off by default.
GLOBAL_EQUITY_ENABLED=false
GLOBAL_EQUITY_SYMBOLS=SPY.US,AAPL.US,SAP.DE
GLOBAL_EQUITY_POLL_INTERVAL_SEC=15
OPPORTUNITY_MAX_EXECUTIONS_PER_CYCLE=3
RISK_ALLOW_PARTIAL_SIZING=true

# Optional dashboard auth for public exposure (disabled by default).
DASHBOARD_BASIC_AUTH_ENABLED=false
DASHBOARD_BASIC_AUTH_USERNAME=moreney
DASHBOARD_BASIC_AUTH_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Realtime public market data (WebSockets only — no private APIs / no paid feeds)
MARKET_DATA_MODE=local
MARKET_DATA_REDIS_POLL_MS=100
MARKET_DATA_EXCHANGES=binance,kraken,coinbase,bitvavo,okx,bybit
MARKET_DATA_SYMBOLS=BTCEUR,ETHEUR,BNBEUR,XRPEUR,ADAEUR,SOLEUR,LTCEUR,DOGEUR,AVAXEUR,LINKEUR,DOTEUR,UNIEUR,ATOMEUR,NEAREUR,BTCUSDT,ETHUSDT,XRPUSDT,ATOMUSDT,DOTUSDT,EURUSDT
MARKET_DATA_RECORDING_ENABLED=false
MARKET_DATA_RECORDING_PATH=./data/market_data
MARKET_DATA_WS_RECONNECT_BASE_MS=500
MARKET_DATA_WS_RECONNECT_MAX_MS=30000
MARKET_DATA_HEARTBEAT_INTERVAL_MS=15000
MARKET_DATA_CONNECTION_TIMEOUT_MS=10000
MARKET_DATA_REDIS_TTL_SECONDS=30
MARKET_DATA_BOOK_DEPTH=50
MARKET_DATA_CACHE_INTERVAL_MS=250

# Exchange credentials (never hardcode — load from environment only)
# Leave empty in paper mode; required for live mode when implementing adapters.
# Realtime market data does NOT use these — public feeds only.
EXCHANGE_NAME=stub
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSPHRASE=
EXCHANGE_BASE_URL=

# Fleet dashboard (all paper instances)
PAPER_FLEET_URLS=http://127.0.0.1:8001,http://127.0.0.1:8007,http://127.0.0.1:8002,http://127.0.0.1:8008,http://127.0.0.1:8003,http://127.0.0.1:8009,http://127.0.0.1:8004,http://127.0.0.1:8010,http://127.0.0.1:8005,http://127.0.0.1:8006
PAPER_FLEET_LABELS=200 EUR ultra,200 EUR realistic,500 EUR ultra,500 EUR realistic,1000 EUR ultra,1000 EUR realistic,5000 EUR ultra,5000 EUR realistic,25000 EUR ultra,25000 EUR realistic
